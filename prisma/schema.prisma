// VektaAudit: audit management for internal audit teams and audit firms.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// An audit function: an internal audit department or an audit firm.
model Organization {
  id             String    @id @default(cuid())
  name           String
  kind           String    @default("internal") // internal | firm
  currency       String    @default("KES")
  // overdue findings escalate after these many days; level 3 also after a second due-date change
  esc1Days       Int       @default(30)
  esc2Days       Int       @default(60)
  esc3Days       Int       @default(90)
  esc1To         String    @default("Head of the business unit")
  esc2To         String    @default("Chief Financial Officer")
  esc3To         String    @default("Audit committee")
  // Microsoft 365: the customer's tenant (after their admin approves the VektaAudit app), the mailbox audit mail is
  // sent from, the SharePoint site reports are filed in, and the Teams channel workflow that receives notifications
  msTenantId     String?   @unique
  msTenantName   String?
  msConnectedAt  DateTime?
  msConnectedBy  String?
  msMailbox      String?
  spSiteUrl      String?
  spFolder       String    @default("VektaAudit")
  teamsWebhook   String?
  autoReminders  Boolean   @default(false) // email overdue owners and self-assessment owners automatically
  remindersRanAt DateTime?
  lockAfterDays  Int       @default(60) // closed audit files lock this many days after closing
  retentionYears Int       @default(7) // closed audits can be deleted after this many years
  requireMfa     Boolean   @default(false) // password sign-ins need an authenticator code
  aiEnabled      Boolean   @default(true) // Vekta AI on for this organisation
  createdAt      DateTime  @default(now())

  users         User[]
  clients       Client[]
  engagements   Engagement[]
  findings      Finding[]
  documents     Document[]
  auditLogs     AuditLog[]
  counters      Counter[]
  invites       Invite[]
  entities      AuditableEntity[]
  plans         AuditPlan[]
  risks         Risk[]
  controls      Control[]
  tests         ControlTest[]
  campaigns     CsaCampaign[]
  dataSets      DataSet[]
  systems       ItSystem[]
  sodRules      SodRule[]
  accessReviews AccessReview[]
  frameworks    Framework[]
  qaReviews     QaReview[]
  conformance   Conformance[]
  apiKeys       ApiKey[]
  aiUsage       AiUsage[]
  programs      ProgramTemplate[]
  packs         CommitteePack[]
  time          TimeEntry[]
  assignments   Assignment[]
}

model User {
  id             String    @id @default(cuid())
  orgId          String
  email          String
  name           String
  title          String?
  role           String    @default("AUDITOR") // ADMIN | MANAGER | AUDITOR | VIEWER
  certifications String? // e.g. CIA, CISA, CPA(K)
  weeklyHours    Int       @default(40)
  msObjectId     String? // Entra object id, after signing in with Microsoft
  totpSecret     String? // authenticator app secret (base32), once confirmed
  totpEnabledAt  DateTime?
  recoveryCodes  Json? // bcrypt hashes of unused recovery codes
  guestUntil     DateTime? // guests (external auditors, regulators) lose access after this
  passwordHash   String
  active         Boolean   @default(true) // deactivated users can't sign in; their history stays
  lastLoginAt    DateTime?
  createdAt      DateTime  @default(now())

  org           Organization  @relation(fields: [orgId], references: [id], onDelete: Cascade)
  leads         Engagement[]  @relation("lead")
  prepared      Procedure[]   @relation("preparer")
  reviewed      Procedure[]   @relation("reviewer")
  reviewNotes   ReviewNote[]
  raised        Finding[]     @relation("raisedBy")
  planItems     PlanItem[]
  testsPrepared ControlTest[] @relation("testPreparer")
  testsReviewed ControlTest[] @relation("testReviewer")
  time          TimeEntry[]
  assignments   Assignment[]
  qaReviews     QaReview[]
  guestAccess   GuestAccess[]

  @@unique([orgId, email])
  @@index([email])
}

/// The entity being audited (a company for an audit firm; a department or subsidiary for internal audit).
model Client {
  id           String    @id @default(cuid())
  orgId        String
  name         String
  industry     String?
  yearEnd      String? // e.g. "30 June"
  framework    String? // e.g. IFRS Accounting Standards
  law          String? // e.g. Companies Act, 2015
  regNumber    String? // company registration number
  taxId        String? // e.g. KRA PIN
  address      String?
  contactName  String?
  contactTitle String?
  contactEmail String?
  contactPhone String?
  notes        String?
  country      String?
  currency     String? // when it differs from the organisation's
  archivedAt   DateTime? // archived clients are hidden from pickers but keep their audits
  createdAt    DateTime  @default(now())

  org         Organization      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  engagements Engagement[]
  entities    AuditableEntity[]

  @@index([orgId])
}

/// An invitation to join an organisation. The link carries the token; it works once, until it expires.
model Invite {
  id            String    @id @default(cuid())
  orgId         String
  email         String
  name          String?
  role          String    @default("AUDITOR")
  title         String?
  token         String    @unique
  invitedBy     String
  expiresAt     DateTime
  acceptedAt    DateTime?
  revokedAt     DateTime?
  guestUntil    DateTime? // a guest invitation: access ends on this date
  engagementIds Json? // and covers only these engagements
  createdAt     DateTime  @default(now())

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId])
}

model Engagement {
  id               String    @id @default(cuid())
  orgId            String
  clientId         String?
  code             String // ENG-2027-014
  name             String
  area             String? // Finance, Technology...
  kind             String    @default("internal") // internal | financial
  phase            String    @default("planning") // planning | risk | fieldwork | review | reporting | followup | closed
  objective        String?
  leadId           String?
  periodStart      DateTime?
  periodEnd        DateTime?
  dueDate          DateTime?
  budgetHours      Int       @default(0)
  actualHours      Int       @default(0)
  // financial audits: materiality, whole currency units
  materialityBasis String?
  materiality      BigInt?
  performanceMat   BigInt?
  trivialMat       BigInt?
  tbImportedAt     DateTime?
  tbSource         String?
  rating           String? // satisfactory | needs_improvement | unsatisfactory
  ratedAt          DateTime?
  closedAt         DateTime? // set when the engagement is closed; the file locks a while after
  unlockedUntil    DateTime? // an admin reopened a locked file until this time
  legalHold        Boolean   @default(false) // never deleted while on hold
  legalHoldNote    String?
  createdAt        DateTime  @default(now())

  org         Organization      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  client      Client?           @relation(fields: [clientId], references: [id], onDelete: SetNull)
  lead        User?             @relation("lead", fields: [leadId], references: [id], onDelete: SetNull)
  procedures  Procedure[]
  reviewNotes ReviewNote[]
  findings    Finding[]
  requests    EvidenceRequest[]
  portalLinks PortalLink[]
  documents   Document[]
  leadsTb     LeadSchedule[]
  tbLines     TbLine[]
  planItem    PlanItem?
  tests       ControlTest[]
  dataSets    DataSet[]
  qaReviews   QaReview[]
  guestAccess GuestAccess[]
  time        TimeEntry[]
  assignments Assignment[]

  @@unique([orgId, code])
  @@index([orgId, phase])
}

/// A step of the work program: a test the auditor performs, prepared then reviewed.
model Procedure {
  id           String    @id @default(cuid())
  engagementId String
  ref          String // P-04
  title        String
  control      String? // the control or assertion it tests
  status       String    @default("not_started") // not_started | in_progress | in_review | signed_off
  conclusion   String?
  preparedById String?
  preparedAt   DateTime?
  reviewedById String?
  reviewedAt   DateTime?
  sort         Int       @default(0)
  createdAt    DateTime  @default(now())

  engagement Engagement   @relation(fields: [engagementId], references: [id], onDelete: Cascade)
  preparedBy User?        @relation("preparer", fields: [preparedById], references: [id], onDelete: SetNull)
  reviewedBy User?        @relation("reviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  notes      ReviewNote[]

  @@index([engagementId, sort])
}

/// Reviewer ↔ preparer conversation on the file. A note is open until resolved.
model ReviewNote {
  id           String    @id @default(cuid())
  engagementId String
  procedureId  String?
  authorId     String
  body         String
  resolvedAt   DateTime?
  createdAt    DateTime  @default(now())

  engagement Engagement @relation(fields: [engagementId], references: [id], onDelete: Cascade)
  procedure  Procedure? @relation(fields: [procedureId], references: [id], onDelete: SetNull)
  author     User       @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([engagementId, createdAt])
}

/// An issue raised by the audit, written up in the condition / criteria / cause / effect / recommendation format.
model Finding {
  id             String    @id @default(cuid())
  orgId          String
  engagementId   String
  code           String // FND-0412
  title          String
  severity       String    @default("medium") // high | medium | low
  status         String    @default("awaiting_response") // awaiting_response | in_remediation | pending_validation | closed
  condition      String?
  criteria       String?
  cause          String?
  effect         String?
  recommendation String?
  mgmtResponse   String?
  ownerName      String?
  ownerEmail     String?
  dueDate        DateTime?
  repeat         Boolean   @default(false)
  originalDue    DateTime? // the first agreed due date
  dueChanges     Int       @default(0) // times the due date was moved
  remindedAt     DateTime? // last reminder email
  raisedById     String?
  closedAt       DateTime?
  createdAt      DateTime  @default(now())

  org        Organization   @relation(fields: [orgId], references: [id], onDelete: Cascade)
  engagement Engagement     @relation(fields: [engagementId], references: [id], onDelete: Cascade)
  raisedBy   User?          @relation("raisedBy", fields: [raisedById], references: [id], onDelete: SetNull)
  events     FindingEvent[]

  @@unique([orgId, code])
  @@index([orgId, status])
}

model FindingEvent {
  id        String   @id @default(cuid())
  findingId String
  kind      String // raised | response | status | evidence | reminder | comment
  body      String
  actorName String
  createdAt DateTime @default(now())

  finding Finding @relation(fields: [findingId], references: [id], onDelete: Cascade)

  @@index([findingId, createdAt])
}

/// A "provided by client" request: something the auditee must send.
model EvidenceRequest {
  id           String    @id @default(cuid())
  engagementId String
  code         String // PBC-07
  title        String
  detail       String?
  dueDate      DateTime?
  status       String    @default("open") // open | submitted | needs_info | accepted
  assigneeName String?
  auditorNote  String? // what the auditor asked for when sending it back
  clientNote   String? // the auditee's note on their last upload
  submittedAt  DateTime?
  acceptedAt   DateTime?
  createdAt    DateTime  @default(now())

  engagement Engagement @relation(fields: [engagementId], references: [id], onDelete: Cascade)
  documents  Document[]

  @@unique([engagementId, code])
}

/// A link the auditee uses to answer requests without an account.
model PortalLink {
  id           String    @id @default(cuid())
  engagementId String
  token        String    @unique
  name         String
  email        String?
  title        String?
  revokedAt    DateTime?
  lastSeenAt   DateTime?
  createdAt    DateTime  @default(now())

  engagement Engagement @relation(fields: [engagementId], references: [id], onDelete: Cascade)
}

/// A file on the audit file. Uploading the same name to the same folder adds a version.
model Document {
  id           String    @id @default(cuid())
  orgId        String
  engagementId String?
  requestId    String?
  csaItemId    String?
  folder       String    @default("C · Fieldwork")
  name         String
  ext          String
  mime         String
  size         Int
  storageKey   String
  version      Int       @default(1)
  linkRef      String? // the working-paper or procedure reference it supports, e.g. C1.3
  source       String    @default("auditor") // auditor | client | generated
  status       String    @default("uploaded") // uploaded | reviewed | client_upload
  template     String? // generated documents: the template key
  uploadedBy   String
  aiSummary    Json? // Vekta AI's summary, kept so it's only made once
  aiSummaryAt  DateTime?
  createdAt    DateTime  @default(now())

  org        Organization     @relation(fields: [orgId], references: [id], onDelete: Cascade)
  engagement Engagement?      @relation(fields: [engagementId], references: [id], onDelete: Cascade)
  request    EvidenceRequest? @relation(fields: [requestId], references: [id], onDelete: SetNull)
  csaItem    CsaItem?         @relation(fields: [csaItemId], references: [id], onDelete: SetNull)

  @@index([orgId, engagementId, folder])
}

/// A lead schedule: one line of the financial statements, built from trial-balance accounts.
model LeadSchedule {
  id           String @id @default(cuid())
  engagementId String
  code         String // A, B, C...
  name         String
  section      String @default("bs") // bs (financial position) | is (profit or loss)
  risk         String @default("normal") // normal | elevated | significant
  status       String @default("not_started") // not_started | testing | in_review | signed_off
  sort         Int    @default(0)

  engagement Engagement @relation(fields: [engagementId], references: [id], onDelete: Cascade)

  @@unique([engagementId, code])
}

/// A trial-balance account. Debits positive, credits negative, whole currency units.
model TbLine {
  id           String  @id @default(cuid())
  engagementId String
  account      String
  name         String
  leadCode     String?
  prior        BigInt  @default(0)
  current      BigInt  @default(0)

  engagement Engagement @relation(fields: [engagementId], references: [id], onDelete: Cascade)

  @@unique([engagementId, account])
}

/// Who did what, when. Written for every change; never edited.
model AuditLog {
  id        String   @id @default(cuid())
  orgId     String
  actorName String
  action    String
  entity    String
  entityId  String?
  detail    String?
  createdAt DateTime @default(now())

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId, createdAt])
}

model Counter {
  orgId String
  key   String
  value Int    @default(0)

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@id([orgId, key])
}

/// Something the audit function could audit (a process, function, system or location), scored for inherent risk.
/// Together these make up the audit universe that the annual plan is built from.
model AuditableEntity {
  id            String    @id @default(cuid())
  orgId         String
  clientId      String? // the client or unit it belongs to
  code          String // AU-014
  name          String
  category      String? // Finance, Operations, Technology...
  owner         String?
  impact        Int       @default(3) // 1–5
  likelihood    Int       @default(3) // 1–5
  controlEnv    String    @default("adequate") // strong | adequate | needs_improvement | weak
  cycleMonths   Int       @default(24) // audit at least this often
  lastAuditedAt DateTime?
  notes         String?
  archivedAt    DateTime?
  createdAt     DateTime  @default(now())

  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  client    Client?      @relation(fields: [clientId], references: [id], onDelete: SetNull)
  planItems PlanItem[]

  @@unique([orgId, code])
  @@index([orgId])
}

/// The audit plan for a year: drafted, submitted, then approved (normally by the audit committee).
model AuditPlan {
  id            String    @id @default(cuid())
  orgId         String
  year          Int
  capacityHours Int       @default(0)
  status        String    @default("draft") // draft | submitted | approved
  submittedAt   DateTime?
  approvedAt    DateTime?
  approvedBy    String? // e.g. "Audit Committee, meeting of 12 Feb 2027"
  createdAt     DateTime  @default(now())

  org   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  items PlanItem[]

  @@unique([orgId, year])
}

/// One planned audit. Starting it creates the engagement.
model PlanItem {
  id           String   @id @default(cuid())
  planId       String
  entityId     String?
  title        String
  kind         String   @default("assurance") // assurance | it | compliance | advisory | followup
  leadId       String?
  hours        Int      @default(0)
  startMonth   Int      @default(1) // 1–12
  endMonth     Int      @default(1)
  status       String   @default("planned") // planned | in_progress | completed | deferred | cancelled
  note         String? // why it was deferred or cancelled
  engagementId String?  @unique
  createdAt    DateTime @default(now())

  plan       AuditPlan        @relation(fields: [planId], references: [id], onDelete: Cascade)
  entity     AuditableEntity? @relation(fields: [entityId], references: [id], onDelete: SetNull)
  lead       User?            @relation(fields: [leadId], references: [id], onDelete: SetNull)
  engagement Engagement?      @relation(fields: [engagementId], references: [id], onDelete: SetNull)

  @@index([planId, startMonth])
}

/// A risk in the library: what could go wrong in a process.
model Risk {
  id        String   @id @default(cuid())
  orgId     String
  code      String // R-012
  process   String
  title     String
  detail    String?
  rating    String   @default("medium") // critical | high | medium | low
  createdAt DateTime @default(now())

  org      Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  controls Control[]

  @@unique([orgId, code])
}

/// A control in the library, mapped to the risks it addresses. Test results update its ratings.
model Control {
  id           String    @id @default(cuid())
  orgId        String
  code         String // C-031
  process      String
  title        String
  detail       String?
  type         String    @default("preventive") // preventive | detective
  nature       String    @default("manual") // manual | automated | it_dependent
  frequency    String    @default("monthly") // per_transaction | multiple_daily | daily | weekly | monthly | quarterly | annual | continuous
  key          Boolean   @default(true)
  ownerName    String?
  assertion    String?
  component    String? // COSO component
  design       String    @default("not_assessed") // not_assessed | effective | needs_improvement | ineffective
  operating    String    @default("not_tested") // not_tested | effective | effective_exception | ineffective
  lastTestedAt DateTime?
  createdAt    DateTime  @default(now())

  org          Organization  @relation(fields: [orgId], references: [id], onDelete: Cascade)
  risks        Risk[]
  tests        ControlTest[]
  csa          CsaItem[]
  requirements Requirement[]

  @@unique([orgId, code])
}

/// A test of one control on an engagement: the workpaper, with sampling, attributes and results.
model ControlTest {
  id               String    @id @default(cuid())
  orgId            String
  engagementId     String
  controlId        String
  ref              String // CT-03
  testType         String    @default("operating") // design | operating
  periodStart      DateTime?
  periodEnd        DateTime?
  population       Int?
  populationValue  BigInt?
  populationSource String?
  method           String    @default("random") // random | systematic | haphazard | judgemental | full
  confidence       Int       @default(90) // %
  tolerableRate    Int       @default(5) // %
  attributes       Json      @default("[]") // [{ key, label, how }]
  status           String    @default("in_progress") // in_progress | in_review | concluded
  result           String? // effective | effective_exception | ineffective
  conclusion       String?
  preparedById     String?
  preparedAt       DateTime?
  reviewedById     String?
  reviewedAt       DateTime?
  createdAt        DateTime  @default(now())

  org        Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  engagement Engagement   @relation(fields: [engagementId], references: [id], onDelete: Cascade)
  control    Control      @relation(fields: [controlId], references: [id], onDelete: Cascade)
  preparedBy User?        @relation("testPreparer", fields: [preparedById], references: [id], onDelete: SetNull)
  reviewedBy User?        @relation("testReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  samples    TestSample[]

  @@unique([engagementId, ref])
}

/// One item in a control test's sample. results maps attribute key to "pass" | "fail" | "na".
model TestSample {
  id          String  @id @default(cuid())
  testId      String
  idx         Int
  ref         String
  description String?
  amount      BigInt?
  results     Json    @default("{}")
  comment     String?

  test ControlTest @relation(fields: [testId], references: [id], onDelete: Cascade)

  @@index([testId, idx])
}

/// A control self-assessment round: control owners confirm their controls worked, audit checks a sample.
model CsaCampaign {
  id        String    @id @default(cuid())
  orgId     String
  title     String
  period    String? // e.g. "July – September 2026"
  dueDate   DateTime?
  status    String    @default("open") // open | closed
  createdBy String
  createdAt DateTime  @default(now())

  org      Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  requests CsaRequest[]
}

/// One control owner's set of controls in a campaign, answered through a link without an account.
model CsaRequest {
  id          String    @id @default(cuid())
  campaignId  String
  ownerName   String
  ownerEmail  String?
  token       String    @unique
  lastSeenAt  DateTime?
  emailedAt   DateTime?
  submittedAt DateTime?
  createdAt   DateTime  @default(now())

  campaign CsaCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  items    CsaItem[]
}

model CsaItem {
  id             String    @id @default(cuid())
  requestId      String
  controlId      String
  answer         String? // effective | partly | not_effective
  comment        String?
  respondedAt    DateTime?
  validation     String? // agree | disagree
  validationNote String?
  validatedBy    String?
  validatedAt    DateTime?

  request   CsaRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  control   Control    @relation(fields: [controlId], references: [id], onDelete: Cascade)
  documents Document[]

  @@unique([requestId, controlId])
}

/// A report to the audit committee. Built from live data; frozen into a snapshot when issued.
model CommitteePack {
  id          String    @id @default(cuid())
  orgId       String
  title       String
  meetingDate DateTime?
  periodStart DateTime
  periodEnd   DateTime
  summary     String?
  status      String    @default("draft") // draft | issued
  snapshot    Json?
  issuedAt    DateTime?
  issuedBy    String?
  spUrl       String? // where it was saved in SharePoint
  createdAt   DateTime  @default(now())

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
}

/// Time a person spent, on an engagement or not.
model TimeEntry {
  id           String   @id @default(cuid())
  orgId        String
  userId       String
  engagementId String?
  date         DateTime
  hours        Float
  category     String   @default("audit") // audit | admin | training | leave
  note         String?
  createdAt    DateTime @default(now())

  org        Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  engagement Engagement?  @relation(fields: [engagementId], references: [id], onDelete: SetNull)

  @@index([orgId, date])
  @@index([userId, date])
}

/// Who is booked on what, and when: an engagement, leave or training.
model Assignment {
  id             String   @id @default(cuid())
  orgId          String
  userId         String
  engagementId   String?
  kind           String   @default("audit") // audit | leave | training | other
  label          String?
  outlookEventId String? // the event added to the person's Outlook calendar
  start          DateTime
  end            DateTime
  createdAt      DateTime @default(now())

  org        Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  engagement Engagement?  @relation(fields: [engagementId], references: [id], onDelete: Cascade)

  @@index([orgId, start])
}

/// A data extract uploaded for analytics: journals, payments or payroll. Rows keep the raw cells; columns maps fields to them.
model DataSet {
  id           String   @id @default(cuid())
  orgId        String
  engagementId String?
  kind         String // journals | payments | payroll
  name         String
  headers      Json // the file's column headings
  columns      Json // field key → column index
  rowCount     Int
  uploadedBy   String
  createdAt    DateTime @default(now())

  org        Organization  @relation(fields: [orgId], references: [id], onDelete: Cascade)
  engagement Engagement?   @relation(fields: [engagementId], references: [id], onDelete: SetNull)
  rows       DataRow[]
  runs       AnalyticRun[]

  @@index([orgId])
}

model DataRow {
  id        String @id @default(cuid())
  dataSetId String
  idx       Int
  cells     Json

  dataSet DataSet @relation(fields: [dataSetId], references: [id], onDelete: Cascade)

  @@index([dataSetId, idx])
}

/// One analytics check run over a data set. Each hit is an exception for someone to review.
model AnalyticRun {
  id        String   @id @default(cuid())
  dataSetId String
  rule      String
  params    Json     @default("{}")
  tested    Int
  hits      Int
  summary   Json? // extra results, e.g. the first-digit distribution
  ranBy     String
  ranAt     DateTime @default(now())

  dataSet    DataSet             @relation(fields: [dataSetId], references: [id], onDelete: Cascade)
  exceptions AnalyticException[]

  @@index([dataSetId, rule])
}

model AnalyticException {
  id         String    @id @default(cuid())
  runId      String
  rowIdx     Int
  detail     String
  status     String    @default("open") // open | explained | finding
  note       String?
  reviewedBy String?
  reviewedAt DateTime?
  findingId  String?
  aiNote     Json? // Vekta AI's explanation, kept so it's only made once

  run AnalyticRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId])
}

/// A system in IT audit scope, with its IT general control ratings.
model ItSystem {
  id           String    @id @default(cuid())
  orgId        String
  name         String
  description  String?
  ownerName    String?
  ownerEmail   String?
  critical     Boolean   @default(true)
  access       String    @default("not_tested") // ITGC ratings: not_tested | effective | needs_improvement | ineffective | not_applicable
  change       String    @default("not_tested")
  operations   String    @default("not_tested")
  development  String    @default("not_applicable")
  lastTestedAt DateTime?
  notes        String?
  createdAt    DateTime  @default(now())

  org      Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  sodRules SodRule[]
  lists    AccessList[]
}

/// Two roles no one person should hold together in a system.
model SodRule {
  id          String  @id @default(cuid())
  orgId       String
  systemId    String
  roleA       String
  roleB       String
  risk        String  @default("high")
  description String?

  org    Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  system ItSystem     @relation(fields: [systemId], references: [id], onDelete: Cascade)
}

/// A user access review: system owners confirm who should keep access, through a link.
model AccessReview {
  id        String    @id @default(cuid())
  orgId     String
  title     String
  dueDate   DateTime?
  status    String    @default("open") // open | closed
  createdBy String
  createdAt DateTime  @default(now())

  org   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  lists AccessList[]
}

model AccessList {
  id          String    @id @default(cuid())
  reviewId    String
  systemId    String
  ownerName   String
  ownerEmail  String?
  token       String    @unique
  lastSeenAt  DateTime?
  emailedAt   DateTime?
  submittedAt DateTime?

  review  AccessReview  @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  system  ItSystem      @relation(fields: [systemId], references: [id], onDelete: Cascade)
  entries AccessEntry[]
}

model AccessEntry {
  id         String    @id @default(cuid())
  listId     String
  account    String
  person     String?
  roles      String // separated by ; or |
  department String?
  lastLogin  String?
  decision   String? // keep | remove | change
  comment    String?
  decidedAt  DateTime?
  removedAt  DateTime? // IT confirmed the change was made
  removedBy  String?

  list AccessList @relation(fields: [listId], references: [id], onDelete: Cascade)

  @@index([listId])
}

/// A law, regulation or standard, broken into requirements that are mapped to controls.
model Framework {
  id        String   @id @default(cuid())
  orgId     String
  name      String
  source    String? // the built-in starter it came from, or "imported"
  createdAt DateTime @default(now())

  org          Organization  @relation(fields: [orgId], references: [id], onDelete: Cascade)
  requirements Requirement[]
}

model Requirement {
  id          String  @id @default(cuid())
  frameworkId String
  ref         String
  title       String
  detail      String?
  sort        Int     @default(0)
  applicable  Boolean @default(true)
  note        String? // why it doesn't apply, or other context

  framework Framework @relation(fields: [frameworkId], references: [id], onDelete: Cascade)
  controls  Control[]

  @@index([frameworkId, sort])
}

/// A quality review of a finished engagement, by someone who didn't work on it.
model QaReview {
  id           String    @id @default(cuid())
  orgId        String
  engagementId String
  reviewerId   String
  status       String    @default("in_progress") // in_progress | completed
  results      Json      @default("{}") // criterion → { met: yes | partly | no, note }
  notes        String?
  score        Int?
  completedAt  DateTime?
  createdAt    DateTime  @default(now())

  org        Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  engagement Engagement   @relation(fields: [engagementId], references: [id], onDelete: Cascade)
  reviewer   User         @relation(fields: [reviewerId], references: [id], onDelete: Cascade)
}

/// The audit function's own yearly self-assessment against the professional standards' domains.
model Conformance {
  id        String   @id @default(cuid())
  orgId     String
  year      Int
  ratings   Json     @default("{}") // domain → { rating, gaps, actions }
  updatedBy String
  updatedAt DateTime @updatedAt

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, year])
}

/// An engagement a guest (external auditor or regulator) may read.
model GuestAccess {
  id           String   @id @default(cuid())
  userId       String
  engagementId String
  createdAt    DateTime @default(now())

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  engagement Engagement @relation(fields: [engagementId], references: [id], onDelete: Cascade)

  @@unique([userId, engagementId])
}

/// A key for the read-only API. Only a hash is stored; the key is shown once.
model ApiKey {
  id         String    @id @default(cuid())
  orgId      String
  name       String
  prefix     String // the first characters, to recognise the key
  hash       String    @unique // SHA-256 of the key
  createdBy  String
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?
  revokedAt  DateTime?

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
}

/// One Vekta AI request, for the organisation's usage figures.
model AiUsage {
  id           String   @id @default(cuid())
  orgId        String
  feature      String
  model        String
  inputTokens  Int
  outputTokens Int
  userName     String
  createdAt    DateTime @default(now())

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId, createdAt])
}

/// A work program the organisation saved for reuse: an ordered list of procedures.
model ProgramTemplate {
  id        String   @id @default(cuid())
  orgId     String
  name      String
  area      String?
  steps     Json // [{ title, control }]
  createdBy String
  createdAt DateTime @default(now())

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId])
}
