{
  "name": "vektaaudit",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3400",
    "build": "next build",
    "serve": "next start -H 127.0.0.1 -p 3400",
    "typecheck": "tsc --noEmit",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "tsx --env-file=.env prisma/seed.ts",
    "db:seed:enterprise": "tsx --env-file=.env prisma/seed-enterprise.ts && tsx --env-file=.env prisma/seed-phase2.ts && tsx --env-file=.env prisma/seed-phase3.ts",
    "db:studio": "prisma studio",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "bcryptjs": "2.4.3",
    "clsx": "^2.1.1",
    "jose": "5.9.6",
    "lucide-react": "^0.460.0",
    "next": "15.5.28",
    "pdfkit": "^0.17.2",
    "qrcode": "^1.5.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "^0.0.1",
    "zod": "3.24.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "2.4.6",
    "@types/node": "^22.10.0",
    "@types/pdfkit": "^0.17.3",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "prisma": "6.19.3",
    "tailwindcss": "^3.4.17",
    "tsx": "4.19.2",
    "typescript": "^5.7.0"
  }
}
